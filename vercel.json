{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "public" } },
    { "src": "public/index.php", "use": "vercel-php@0.9.0" },
    { "src": "public/phpversion.php", "use": "vercel-php@0.9.0" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/build/$1" },
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/cert/(.*)", "dest": "/cert/$1" },
    { "src": "/projectDesigns/(.*)", "dest": "/projectDesigns/$1" },
    { "src": "/Resume/(.*)", "dest": "/Resume/$1" },
    { "src": "/phpversion.php", "dest": "/public/phpversion.php" },
    { "src": "/(.*)", "dest": "/public/index.php" }
  ]
}