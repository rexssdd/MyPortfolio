{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "public/build" } },
    { "src": "public/index.php", "use": "vercel-php@0.9.0" },
    { "src": "public/phpversion.php", "use": "vercel-php@0.9.0" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/images/(.*)", "dest": "/public/images/$1" },
    { "src": "/cert/(.*)", "dest": "/public/cert/$1" },
    { "src": "/projectDesigns/(.*)", "dest": "/public/projectDesigns/$1" },
    { "src": "/Resume/(.*)", "dest": "/public/Resume/$1" },
    { "src": "/phpversion.php", "dest": "/public/phpversion.php" },
    { "src": "/(.*)", "dest": "/public/index.php" }
  ]
}