{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "builds": [
    { "src": "public/index.php", "use": "vercel-php@0.7.3" },
    { "src": "public/build/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/public/build/$1" },
    { "src": "/(.*)", "dest": "/public/index.php" }
  ]
}
